OPENAI_API_KEY=
DEV_AGENT_MODEL=gpt-5.3-codex
DEV_AGENT_MAX_OUTPUT_TOKENS=4000
DEV_AGENT_REASONING_EFFORT=high
DEV_AGENT_TEXT_VERBOSITY=medium
# Roteamento híbrido: Terra para rotina; Codex continua para tarefas críticas.
DEV_AGENT_ROUTINE_ENABLED=true
DEV_AGENT_ROUTINE_MODEL=gpt-5.6-terra
DEV_AGENT_DAILY_REQUEST_LIMIT=5
DEV_AGENT_DAILY_TOKEN_BUDGET=30000
# Para publicar: senha de acesso, segredo aleatório (32+ caracteres) e cookies HTTPS.
DEV_AGENT_APP_PASSWORD=
DEV_AGENT_SESSION_SECRET=
DEV_AGENT_COOKIE_SECURE=true
# Aponte para um volume persistente da hospedagem, por exemplo: /data/agent.db
DEV_AGENT_DATABASE_PATH=
# Pasta permitida para execução de testes. Em nuvem, monte seu projeto aqui.
DEV_AGENT_WORKSPACE=
